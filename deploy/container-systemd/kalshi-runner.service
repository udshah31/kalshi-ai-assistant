[Unit]
Description=Kalshi runner (pinned Python container)
Requires=docker.service kalshi-dashboard.service
After=docker.service network-online.target kalshi-dashboard.service
Wants=network-online.target
ConditionPathExists=/var/lib/kalshi/btc_15m_state.json
ConditionPathExists=/var/lib/kalshi/btc_15m_state_archive.sqlite3

[Service]
Type=simple
WorkingDirectory=/opt/kalshi
ExecStart=/opt/kalshi/deploy/container-python runner /opt/kalshi/live_runner.py --forever --poll-seconds 30 --dashboard-url http://127.0.0.1:8765 --lookback-minutes 1440 --state-file /var/lib/kalshi/btc_15m_state.json --log-file /var/lib/kalshi/live_session.jsonl --kalshi-series KXBTC15M
ExecStop=/usr/bin/docker stop --time 130 kalshi-runner
Restart=always
RestartSec=5
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
