[Unit]
Description=Kalshi late-window collector (pinned Python container)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/kalshi/btc_15m_state.json

[Service]
Type=simple
WorkingDirectory=/opt/kalshi
ExecStart=/opt/kalshi/deploy/container-python late /opt/kalshi/late_window.py --state-file /var/lib/kalshi/btc_15m_state.json --kalshi-series KXBTC15M
ExecStop=/usr/bin/docker stop --time 30 kalshi-late
Restart=always
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
